{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowcast.jaismith.dev/schema/v1/sites.schema.json",
  "title": "/data/v1/sites.json: every site flowcast can forecast (site selector and overview map)",
  "type": "object",
  "required": [
    "schema",
    "generated",
    "sites"
  ],
  "properties": {
    "schema": {
      "const": "flowcast.sites/v1"
    },
    "generated": {
      "$ref": "common.schema.json#/$defs/time"
    },
    "sites": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "river",
          "town",
          "state",
          "lat",
          "lon",
          "area_mi2",
          "forecast_ready",
          "forecast_issued_at"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/site_id"
          },
          "slug": {
            "type": [
              "string",
              "null"
            ],
            "description": "Friendly route alias (/site/callicoon); null if none"
          },
          "name": {
            "type": "string",
            "description": "Cleaned-up gauge name, e.g. 'Delaware River at Callicoon, NY'"
          },
          "river": {
            "type": "string"
          },
          "town": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "pattern": "^[A-Z]{2}$",
            "description": "The town's state (from the station name), not the gauge record's: Callicoon and Lordville are NY although USGS files both gauges under PA"
          },
          "lat": {
            "type": "number",
            "description": "Gauge latitude"
          },
          "lon": {
            "type": "number",
            "description": "Gauge longitude"
          },
          "area_mi2": {
            "type": "number",
            "description": "Drainage area, square miles (USGS)"
          },
          "forecast_ready": {
            "type": "boolean",
            "description": "Onboarded for live forecasts: the page has live.json and a visit wakes a forecast. False: the model covers the basin but it isn't served yet"
          },
          "forecast_issued_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Issue time of the newest live forecast, or null"
          },
          "status": {
            "oneOf": [
              {
                "$ref": "common.schema.json#/$defs/status"
              },
              {
                "type": "null"
              }
            ],
            "description": "Lazy-forecast status of a ready site; null when not ready"
          },
          "always_on": {
            "type": "boolean"
          },
          "has_temperature": {
            "type": "boolean",
            "description": "The water-temperature model covers this basin"
          },
          "live_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "/data/v1/sites/{id}/live.json for ready sites, else null"
          }
        }
      }
    }
  }
}
