{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowcast.jaismith.dev/schema/v1/api.schema.json",
  "title": "/api/visit and /api/status responses",
  "$defs": {
    "visit": {
      "description": "POST /api/visit?site={site} (empty body). Extends the site's active window by 7 days and starts a wake run if the latest available issue has no forecast yet. 404 for unknown sites.",
      "type": "object",
      "required": ["site", "state", "forecast", "awake_until"],
      "properties": {
        "site": {"$ref": "common.schema.json#/$defs/slug"},
        "state": {"$ref": "common.schema.json#/$defs/state"},
        "awake_until": {"type": ["string", "null"], "format": "date-time"},
        "forecast": {"$ref": "common.schema.json#/$defs/forecast_pointer"},
        "target_issue": {"$ref": "common.schema.json#/$defs/issue_key", "description": "The issue a wake is producing (latest 00/06/12/18Z issue whose inputs are available)"},
        "eta_s": {"type": ["integer", "null"], "description": "Expected seconds until the wake's forecast is published; null when no wake runs"}
      }
    },
    "status": {
      "description": "GET /api/status?site={site}",
      "type": "object",
      "required": ["site", "state", "forecast"],
      "properties": {
        "site": {"$ref": "common.schema.json#/$defs/slug"},
        "state": {"$ref": "common.schema.json#/$defs/state"},
        "awake_until": {"type": ["string", "null"], "format": "date-time"},
        "forecast": {"$ref": "common.schema.json#/$defs/forecast_pointer"},
        "run": {
          "type": ["object", "null"],
          "description": "The newest run for the site",
          "properties": {
            "issue": {"$ref": "common.schema.json#/$defs/issue_key"},
            "status": {"enum": ["running", "done", "failed"]},
            "started": {"$ref": "common.schema.json#/$defs/time"},
            "finished": {"type": ["string", "null"], "format": "date-time"}
          }
        }
      }
    },
    "error": {
      "type": "object",
      "required": ["error"],
      "properties": {"error": {"type": "string"}}
    }
  }
}
